<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sologallery.bucket-backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd /Users/haoliang/code/github/soloGallery &amp;&amp; ./node_modules/.bin/tsx scripts/backup-buckets-nas.mts</string>
    </array>
    <!-- 每天 03:40（服务器 03:00 备份完成后）：三桶增量同步 + db 备份镜像到 NAS -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>40</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/haoliang/Library/Logs/bucket-backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/haoliang/Library/Logs/bucket-backup.log</string>
</dict>
</plist>
