# ---- 数据库（MySQL 8）----
DATABASE_URL="mysql://sologallery:sologallery@127.0.0.1:3306/sologallery"

# ---- MinIO（与桌面壁纸软件共用的桶）----
# 内部访问端点（服务端 SDK 用）
MINIO_ENDPOINT="127.0.0.1"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="wallpapers"
# 公共访问基地址（浏览器直接读 display/ 与 thumbs/ 用，须与桶 policy 的公共读前缀匹配）
# 例：https://minio.example.com 或 http://192.168.1.10:9000
MINIO_PUBLIC_BASE_URL="http://127.0.0.1:9000"

# ---- 应用 ----
SITE_URL="http://localhost:3000"
# iron-session 密码，至少 32 字符。必须替换为随机串（openssl rand -hex 32）——
# 含 change-me/example/placeholder 等占位词的值会被启动检查直接拒绝
SESSION_SECRET=""
# 首次 seed 创建的管理员。ADMIN_PASSWORD 必填且至少 8 位——
# 留空或弱密码（如 admin123456）会被 seed 拒绝，不存在默认密码
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
# 部署在可信反向代理（nginx/CDN）之后时设为 true，限流才会采信 X-Forwarded-For
# 区分客户端 IP（要求反代覆写 XFF 而非追加）。默认 false：转发头视为可伪造，
# 登录爆破/评论限流退化为全局桶——直连部署时的安全默认
TRUST_PROXY="false"

# ---- 同步 ----
# 应用内定时同步开关与最小间隔（分钟）；后台也可手动触发
SYNC_ENABLED="true"
SYNC_INTERVAL_MINUTES="15"
# 导入并发（默认 3；服务器出口带宽受限时提升收益有限）
SYNC_CONCURRENCY="3"
